<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <form action="/users" method="POST">
        <label>
            <!-- including an ejs tag with locals.firstName puts in a default value on the rendered page. You can use locals.firstName, but the 'locals' is unnecessary. It was passed as 'firstName: 'Test'' -->
             <!-- this will save the input as req.body.firstName. the 'name' attribute determines the key in req.body  -->
            <input type="text" name="firstName" value="<%= firstName %>">
        </label>
        <button type="submit">Submit</button>
    </form>
</body>
</html>